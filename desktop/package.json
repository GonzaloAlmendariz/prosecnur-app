{
  "name": "prosecnur-desktop",
  "version": "0.9.5",
  "private": true,
  "description": "Desktop shell for Prosecnur",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "smoke:electron": "node smoke-electron.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:mac:publish": "electron-builder --mac --publish=always"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "overrides": {
      "form-data": "^4.0.6",
      "tmp": "^0.2.6",
      "undici": "^6.29.1",
      "tar": "^7.5.21",
      "js-yaml@4": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "app-builder-lib": ">=26.15.0",
      "builder-util-runtime": ">=9.7.0",
      "fast-uri": "^3.1.8",
      "@xmldom/xmldom@0.8": "^0.8.15",
      "@xmldom/xmldom@0.9": "^0.9.12",
      "http-cache-semantics": "^4.3.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg",
        "GHSA-jmr9-qjv8-65gv"
      ]
    }
  },
  "devDependencies": {
    "electron": "^42.11.18",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "build": {
    "appId": "pe.pucp.prosecnur",
    "productName": "Prosecnur",
    "directories": {
      "output": "../dist.nosync/mac-builder-output",
      "buildResources": "../packaging/macos/build-resources"
    },
    "beforePack": "scripts/clean-mac-xattrs.cjs",
    "afterPack": "scripts/after-pack-mac.cjs",
    "files": [
      "main.cjs",
      "lifecycle.cjs",
      "preview-renderer.cjs",
      "security.cjs",
      "hf-publish-broker.cjs",
      "preload.cjs",
      "auto-updater.cjs",
      "mac-bootstrap.cjs",
      "app-update.yml",
      "package.json",
      "assets/**/*",
      "!node_modules/**/{CHANGELOG.md,README.md,readme.md}",
      "!node_modules/**/{test,tests,__tests__,powered-test,example,examples,docs}",
      "!node_modules/**/*.{md,d.ts,map}"
    ],
    "extraResources": [
      {
        "from": "../api",
        "to": "Internals/api",
        "filter": [
          "**/*",
          "!tests",
          "!.DS_Store",
          "!outputs"
        ]
      },
      {
        "from": "../launcher",
        "to": "Internals/launcher"
      },
      {
        "from": "../packaging/macos/r-mac-runtime",
        "to": "Internals/r-mac-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../packaging/LEEME_PRIMERO.md",
        "to": "LEEME_PRIMERO.md"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../packaging/third-party/LIBREOFFICE-NOTICE.md",
        "to": "LIBREOFFICE-NOTICE.md"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "../packaging/macos/build-resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": false,
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0",
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "title": "Prosecnur ${version}",
      "icon": "../packaging/macos/build-resources/icon.icns",
      "iconSize": 96,
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "fileAssociations": [
      {
        "ext": "pulso",
        "name": "Proyecto Prosecnur",
        "role": "Editor",
        "icon": "../packaging/macos/build-resources/icon.icns"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "GonzaloAlmendariz",
        "repo": "prosecnur-app"
      }
    ]
  }
}
