{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8"
  },
  "teammateMode": "in-process",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/agentic/hooks/guardas.mjs\"; [ -f \"$f\" ] || exit 0; node \"$f\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/agentic/hooks/guardas.mjs\"; [ -f \"$f\" ] || exit 0; node \"$f\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*__(update_values|append_values|batch_clear_values|update_formulas|insert_dimension|update_spreadsheet|copy_sheet_to_another_spreadsheet)",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/agentic/hooks/guardas.mjs\"; [ -f \"$f\" ] || exit 0; node \"$f\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null || exit 0; tracked=$(git diff --numstat HEAD 2>/dev/null | awk '{s+=$1+$2} END{print s+0}'); untracked=$(git ls-files --others --exclude-standard -z 2>/dev/null | xargs -0 cat 2>/dev/null | wc -l | tr -d ' '); total=$((tracked + untracked)); if [ \"$total\" -gt 1500 ]; then printf '{\"systemMessage\":\"Working tree con %s líneas sin commitear (umbral 1500). Considera /cerrar-trabajo.\"}' \"$total\"; fi",
            "timeout": 15,
            "statusMessage": "Midiendo working tree…"
          }
        ]
      }
    ]
  }
}
