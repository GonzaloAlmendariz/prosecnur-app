# macOS
.DS_Store

# R
.Rhistory
.RData
.Rproj.user/
*.Rproj
Rplots.pdf
renv/library/
renv/local/
renv/staging/
.Rprofile.local

# Node / frontend
node_modules/
.vite/
frontend/dist/
frontend/.vite/
frontend/tmp/
frontend/tsconfig.tsbuildinfo
*.log

# Local app packages. Usamos `dist.nosync/` cuando el repo vive en
# iCloud Drive (el sufijo .nosync hace que iCloud lo ignore y evita
# copias fantasma "Prosecnur 2/3/4..." por conflicto de sync).
# Dejamos `dist/` también para backward-compat con builds viejos.
dist/
dist.nosync/

# Frontend build outputs (regenerados en build):
#   - api/inst/www/        : bundle del Electron (con code splitting)
#   - api/inst/standalone/ : bundle único usado por /api/dashboard/export
api/inst/www/*
!api/inst/www/.gitkeep
api/inst/standalone/

# Editor
.vscode/
.idea/

# Local Claude/Codex worktrees
.claude/worktrees/

# La bóveda de producto es un contrato documental versionado. Solo el estado
# local del editor y los metadatos del sistema operativo quedan fuera.
/Obsidian_Prosecnur/.obsidian/
/Obsidian_Prosecnur/.DS_Store

# Tests
/tests/e2e/results/
/tests/e2e/playwright-report/

# Audit outputs (generados por scripts/ast_corpus_audit.R etc.)
api/outputs/
tmp/

# Outputs de revisión y fuentes metodológicas internas (NO van al repo).
# Contiene documentación interna PULSO (taxonomía 2024-2026, documento
# oficial PUCP Marzo 2026, revisiones, compendio metodológico, análisis
# verticales por estudio). Es material de uso interno del equipo
# metodológico — no debe publicarse en GitHub bajo ninguna condición.
outputs/

# Backups puntuales (ej. fixes manuales de data con .bak_edad_fix)
*.bak_edad_fix
*.bak_*

# Datos del analista (no van al repo)
insumos/

# Artefactos internos extraídos de un .pulso en la raíz del repo.
# Un .pulso real es un zip portable; estos archivos sueltos son staging local.
/manifest.json
/state.rds
/files/

# Build artifacts del paquete R
prosecnurapp_*.tar.gz

# Staging de runtime mac generado por packaging/macos/build-dmg.sh
# (se regenera por arch en cada build, pesa ~300MB con paquetes R + R.pkg).
packaging/macos/r-mac-runtime/

# .icns generado a partir de packaging/windows/brand/icon.svg.
packaging/macos/build-resources/icon.icns
packaging/macos/build-resources/icon.iconset/

# Backups puntuales del .pulso (limpieza manual)
*.pulso.pre-cleanup.bak

# Artefactos generados de reportes y QA (gate 4)
output/pdf/
output/validacion/
output/entrega_acnur_pdm/
output/entrega_acnur_pdm_analitica/

# Toda la carpeta de entregables generados (gate 4): PPTX/PDF/XLSX/HTML/ZIP/MD.
# Cubre los subdirectorios específicos listados arriba y cualquier corte nuevo.
output/*
!output/.gitkeep

# Configuración local de la bóveda de sistema (docs/ abierto como vault).
/docs/.obsidian/
